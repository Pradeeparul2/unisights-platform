# Client - SDK 
export INSIGHTS_ENDPOINT="http://localhost:8000/collect/events"
export INSIGHTS_DEBUG="true"

# Kafka with KRaft
export KAFKA_NODE_ID="1"
export KAFKA_CLUSTER_ID="MkQkQzc4NzAxNTUyNDU3MDQ1"
export KAFKA_PROCESS_ROLES="controller,broker"
export KAFKA_CONTROLLER_QUORUM_VOTERS="1@kafka:9094"

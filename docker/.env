export KAFKA_ADVERTISED_LISTENERS="PLAINTEXT://kafka:9092,EXTERNAL://localhost:9093"
export KAFKA_LISTENER_SECURITY_PROTOCOL_MAP="CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT"
export KAFKA_CONTROLLER_LISTENER_NAMES="CONTROLLER"
export KAFKA_INTER_BROKER_LISTENER_NAME="PLAINTEXT"
export KAFKA_AUTO_CREATE_TOPICS_ENABLE="true"

# kafdrop (UI for Kafka)
export KFFDROP_SERVER_PORT="9003"
export KFFDROP_JVM_OPTS="-Xms64M -Xmx512M"
export KFFDROP_KAFKA_BROKERCONNECT="kafka:9092"

